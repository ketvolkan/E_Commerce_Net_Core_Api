<?xml version="1.0" encoding="utf-8" ?>
<log4net>
	<appender name="JsonFileLogger" type="log4net.Appender.FileAppender">
		<file value="C:\Log\ECommerceLog.json" />
		<appendToFile value="true" />
		<layout type="Core.CrossCuttingConcerns.Logging.Log4Net.Layouts.JsonLayout, Core" />
	</appender>

	<logger name="JsonFileLogger">
		<level value="ALL" />
		<appender-ref ref="JsonFileLogger" />
	</logger>
</log4net>